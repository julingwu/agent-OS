# ---------------------------------------------------------------- v5.4 封版加固
# 生产库与备份一律不入库（data/ 已整体忽略，这里再显式声明一次，防止将来有人删掉上面的规则）
data/*.db
data/*.db-*
data/*.bak*
data/*.bak_*
PROD_DB_HEALTH_*.txt

# 一次性补丁脚本与本地临时产物：不是产品代码，入库存量会把真实历史改乱
scripts/patch_*.py
scripts/fix_*.py
_tmp_*
_seal_*
.tmp*/

# 测试/截图证据目录：浏览器冒烟产物常回显内网地址、Cookie 与企微链接
# v5.4.2：只忽略仓库根的临时截图目录，不要误伤 docs/screenshots/ 里的说明图
/screenshots/
*_evidence/
playwright-report/
test-results/
docs/evidence/


# --- v5.4.3 TLS material: local root CA + server private keys stay on disk only (never committed)
#     generated by deploy/tls/gen_ca_and_cert.sh -> deploy/tls/out/
deploy/tls/out/
deploy/tls/*.key
deploy/tls/*.crt
!deploy/tls/nginx-agentos.conf
.agentos-shots/
build/
desktop/src-tauri/target/

# Allow role seed data to be tracked
!app/data/roles_seed.json
