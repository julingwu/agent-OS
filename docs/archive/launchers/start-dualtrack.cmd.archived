@echo off
setlocal
cd /d "%~dp0"
echo ==========================================================
echo        AgentOS 双轨热切换引擎启动中 (Dual-Track)
echo ==========================================================
echo [*] 启动网关端口: 8077 (浏览器统一入口)
echo [*] 绿进程端口  : 8081 (Green Track)
echo [*] 红进程端口  : 8082 (Red Track)
echo ==========================================================

wscript "%~dp0start-dualtrack.vbs"

echo [*] 双轨服务已在后台静默启动！无黑框常驻。
echo [*] 浏览器已自动打开: http://127.0.0.1:8077/ui/
endlocal
