# AgentOS Local Daemon Background Launcher
param (
    [string]$ServerUrl = "http://127.0.0.1:8077",
    [string]$Token = "local"
)

$RepoDir = Split-Path -Parent $MyInvocation.MyCommand.Path
Set-Location $RepoDir

$PythonExe = Join-Path $RepoDir ".venv\Scripts\pythonw.exe"
if (-not (Test-Path $PythonExe)) {
    $PythonExe = Join-Path $RepoDir ".venv\Scripts\python.exe"
}
if (-not (Test-Path $PythonExe)) {
    $PythonExe = "pythonw.exe"
}

$LogDir = Join-Path $RepoDir "logs"
if (-not (Test-Path $LogDir)) {
    New-Item -ItemType Directory -Path $LogDir -Force | Out-Null
}
$LogFile = Join-Path $LogDir "daemon.log"

# Check if already running
$existing = Get-CimInstance Win32_Process | Where-Object { $_.CommandLine -like "*agentos-daemon.py*" }
if ($existing) {
    Write-Host "[OK] AgentOS Daemon is already running (PID: $($existing.ProcessId))." -ForegroundColor Green
    exit 0
}

Write-Host "[*] Launching AgentOS Lightweight Daemon in background via pythonw..." -ForegroundColor Yellow
$proc = Start-Process -FilePath $PythonExe -ArgumentList "`"$RepoDir\agentos-daemon.py`" --server `"$ServerUrl`" --token `"$Token`"" -WorkingDirectory $RepoDir -WindowStyle Hidden -PassThru
Start-Sleep -Seconds 2

if ($proc -and -not $proc.HasExited) {
    Write-Host "[OK] AgentOS Daemon is running in background (PID: $($proc.Id))" -ForegroundColor Green
    Write-Host "[*] Log file: $LogFile" -ForegroundColor Cyan
} else {
    Write-Host "[ERROR] Failed to start AgentOS Daemon." -ForegroundColor Red
}
