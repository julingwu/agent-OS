# Copy to .env. Never commit credentials or a filled-in .env.
# Before a normal server launch, generate a unique UI_SESSION_SECRET locally:
# python -c "import secrets; print(secrets.token_hex(32))"
UI_SESSION_SECRET=
UI_DEV_LOGIN=0

# Safe demo defaults: model execution is mocked and approval is manual.
UI_RUNNER=mock_acp
RUNNER=mock
AUTO_APPROVE=0
UI_TASK_BUDGET=80000
M0_RUN_TIMEOUT=240
M0_HEARTBEAT_SECONDS=15

# Real integration: set UI_RUNNER=acp and enter your own key locally.
# ACP also loads tools/dsh-acp.patch.yml; edit its provider/model for your setup.
DEEPSEEK_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
# Optional absolute CLI path; otherwise use the installed desktop DSH runtime.
# DSH_CLI=C:/path/to/agent-OS/tools/dsh-cli.cmd
# Optional task data location; use a dedicated directory.
# M0_WORKSPACE=C:/path/to/agent-os-workspace
M0_SANDBOX=lowil
M0_SANDBOX_ACP=1

# External integrations and scheduled work are off in this local example.
UI_CRON=0
WECOM_WATCHER=0
WECOM_APPROVAL_POLLER=0
OCTO_RUNNER=0
EVAL_JUDGE=0
